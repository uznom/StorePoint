{
  "name": "storepoint",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "StorePoint v2 — Open-Source Global Small-Store ERP & Offline-First POS",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node services/gateway/dist/server.js",
    "build": "corepack pnpm -r run build",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r run typecheck",
    "check:limits": "node scripts/check-line-limits.mjs",
    "verify": "node scripts/check-line-limits.mjs && corepack pnpm -r run build && corepack pnpm -r run typecheck && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "@vitest/coverage-v8": "^3.0.8"
  }
}
