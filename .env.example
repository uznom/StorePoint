# StorePoint v2 — Environment Configuration Template
NODE_ENV=development

# Database (Schema-per-Service on single PostgreSQL instance)
DATABASE_URL=postgresql://storepoint:storepoint_dev@localhost:5432/storepoint

# Event Bus (Redis Streams)
REDIS_URL=redis://localhost:6379

# Service Ports
GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
CATALOG_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
POS_SERVICE_PORT=4004
PURCHASING_SERVICE_PORT=4005
FINANCE_CRM_SERVICE_PORT=4006
EXTENSIONS_SERVICE_PORT=4007

# Security (Replace in production)
JWT_SECRET=change-me-to-a-32-byte-high-entropy-secret-in-prod
