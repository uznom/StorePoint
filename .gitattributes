# Auto detect text files and perform LF normalization
* text=auto

# Gradle files
*.bat text eol=crlf
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Java/Kotlin files
*.java text eol=lf
*.kt text eol=lf

# XML files
*.xml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
